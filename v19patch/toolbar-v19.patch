+    public static void dismissOpenPanelFromSystemWindowChange(CharSequence packageName) {
+        ToolbarService service = instance;
+        if (service == null || service.panel == null) return;
+        if (packageName != null && TextUtils.equals(packageName, service.getPackageName())) return;
+        if (SystemClock.uptimeMillis() - service.panelShownUptimeMs < 250L) return;
+
+        service.mainHandler.post(() -> {
+            if (service != instance || service.panel == null) return;
+            if (SystemClock.uptimeMillis() - service.panelShownUptimeMs < 250L) return;
+            service.hidePanel();
+            Log.d(TAG, "Panel dismissed after external/system window change: " + packageName);
+        });
+    }
