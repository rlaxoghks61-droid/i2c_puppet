+    private void observeToolbarNavigationGesture(MotionEvent event) {
+        if (event == null) return;
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                toolbarGestureDownY = event.getRawY();
+                toolbarGestureTracking = true;
+                break;
+            case MotionEvent.ACTION_MOVE:
+                if (toolbarGestureTracking && toolbarGestureDownY - event.getRawY() >= dp(12)) {
+                    toolbarGestureTracking = false;
+                    if (panel != null) hidePanel();
+                    Log.d(TAG, "Panel dismissed on bottom upward navigation gesture");
+                }
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                if (toolbarGestureTracking && panel != null) {
+                    hidePanel();
+                    Log.d(TAG, "Panel dismissed when system navigation took toolbar touch");
+                }
+                toolbarGestureTracking = false;
+                break;
+            case MotionEvent.ACTION_UP:
+                toolbarGestureTracking = false;
+                break;
+            default:
+                break;
+        }
+    }
+
+    public static boolean dismissOpenPanelForBackButton() {
+        ToolbarService service = instance;
+        if (service == null || service.panel == null) return false;
+        service.mainHandler.post(() -> {
+            if (service == instance && service.panel != null) {
+                service.hidePanel();
+                Log.d(TAG, "Panel dismissed and Back button consumed");
+            }
+        });
+        return true;
+    }
